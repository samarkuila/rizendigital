DJANGO_SECRET_KEY=change-me-to-a-random-secret-key
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=yourdomain.com,www.yourdomain.com

# Email — set these to enable real lead-notification emails when someone
# submits a contact/enquiry form. Until EMAIL_HOST_USER is set, emails are
# printed to the console instead of sent, so nothing breaks in local dev.
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=your-sending-address@gmail.com
EMAIL_HOST_PASSWORD=your-smtp-app-password
DEFAULT_FROM_EMAIL=your-sending-address@gmail.com
# Inbox that should receive new lead notifications.
LEAD_NOTIFICATION_EMAIL=admin@rizendigital.com

# --- Production (AWS) ---
DJANGO_CSRF_TRUSTED_ORIGINS=https://rizendigital.com,https://www.rizendigital.com
# Set to False only while testing over plain HTTP before the SSL certificate is installed
DJANGO_SSL_REDIRECT=True
DJANGO_HSTS_SECONDS=3600

# --- Public contact details (leave blank until you have them; blank = hidden on the site) ---
SITE_PHONE=
SITE_FACEBOOK_URL=
SITE_TWITTER_URL=
SITE_YOUTUBE_URL=
SITE_INSTAGRAM_URL=
SITE_LINKEDIN_URL=

# --- Scout demo (/ai-agents/scout/) live AI briefs ---
# Optional. Leave ANTHROPIC_API_KEY blank and the demo still works with template-based page ideas.
# Get a key at console.anthropic.com (API billing is separate from a Claude Pro subscription).
ANTHROPIC_API_KEY=
# claude-opus-5 is the default; claude-sonnet-5 is cheaper and fine for this task.
SCOUT_LLM_MODEL=claude-opus-5
# Max live AI generations per visitor IP per hour (repeat searches are cached and free).
SCOUT_LLM_HOURLY_LIMIT=6

# --- Analytics (leave blank to add no tracking code) ---
# Google Tag Manager container. Defaults to the Rizen Digital container; set to blank to turn it off.
# If GA4 is set up inside GTM, keep GA_MEASUREMENT_ID blank below (otherwise visits are counted twice).
GTM_CONTAINER_ID=GTM-WL9WHQXF
# Google Analytics 4 measurement ID from GA4 > Admin > Data streams, e.g. G-ABC123XYZ
GA_MEASUREMENT_ID=

# WhatsApp: the site shows only a WhatsApp chat button (no phone number / call link).
# SITE_WHATSAPP = number customers message, digits with country code (e.g. 919733585522). Blank = uses SITE_PHONE.
SITE_WHATSAPP=
